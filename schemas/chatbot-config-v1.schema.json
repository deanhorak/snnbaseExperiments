    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "compactAnnStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_consumed_automatically",
        "prepare_driver",
        "training_driver",
        "full_training_run",
        "held_out_quality"
      ],
      "properties": {
        "config_consumed_automatically": {"const": true},
        "prepare_driver": {"const": "implemented"},
        "training_driver": {"const": "implemented"},
        "full_training_run": {"const": "not_run"},
        "held_out_quality": {"const": "not_measured"}
      }
    },
    "compactSnnStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_consumed_automatically",
        "prepare_driver",
        "training_driver",
        "ann_checkpoint_transfer",
        "full_training_run",
        "held_out_quality"
