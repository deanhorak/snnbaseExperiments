{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deanhorak/snnbaseExperiments/schemas/chatbot-config-v1.schema.json",
  "title": "snnbase chatbot resolved config v1",
  "description": "Structural contract for the four Phase 0 chatbot configurations. Cross-field runner argv equivalence is enforced by tools/chatbot_config.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "track",
    "architecture",
    "seed",
    "implementation_status",
    "reference",
    "model",
    "runner_binding"
  ],
  "properties": {
    "schema_version": {"const": "snnbase-chatbot-config-v1"},
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "track": {
      "enum": [
        "compact_trainable_ann_snn",
        "exact_qwen_ann_parity_and_hybrid_snn_conversion"
      ]
    },
    "architecture": {"enum": ["ann", "snn"]},
    "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "implementation_status": {"type": "object"},
    "reference": {"type": "object"},
    "dataset": {"type": "object"},
    "tokenization": {"type": "object"},
    "archive": {"type": "object"},
    "model": {"type": "object"},
    "spiking": {"type": "object"},
    "training": {"type": "object"},
    "runner_binding": {"$ref": "#/$defs/runnerBinding"},
    "evaluation": {"type": "object"},
    "publication_gate": {"type": "object"},
    "oracle": {"type": "object"},
    "claim_boundary": {"type": "object"}
  },
  "oneOf": [
    {
      "required": [
        "dataset",
        "tokenization",
        "training",
        "evaluation",
        "publication_gate"
      ],
      "properties": {
        "track": {"const": "compact_trainable_ann_snn"},
        "architecture": {"const": "ann"},
        "implementation_status": {"$ref": "#/$defs/compactAnnStatus"},
        "reference": {"$ref": "#/$defs/compactReference"},
        "dataset": {"$ref": "#/$defs/dataset"},
        "tokenization": {"$ref": "#/$defs/tokenization"},
        "archive": false,
        "model": {"$ref": "#/$defs/compactAnnModel"},
        "spiking": false,
        "training": {"$ref": "#/$defs/training"},
        "evaluation": {"$ref": "#/$defs/compactAnnEvaluation"},
        "publication_gate": {"$ref": "#/$defs/publicationGate"},
        "oracle": false,
        "claim_boundary": false
      }
    },
    {
      "required": [
        "dataset",
        "tokenization",
        "spiking",
        "training",
        "evaluation",
        "publication_gate"
      ],
      "properties": {
