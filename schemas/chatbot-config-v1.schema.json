      "properties": {
        "config_consumed_automatically": {"const": true},
        "dense_conversion": {"const": "implemented"},
        "archive_loader": {"const": "implemented"},
        "bounded_inspect_protocol": {"const": "implemented"},
        "oracle_gate": {"const": "passed_local_ignored_development_run_not_promoted"},
